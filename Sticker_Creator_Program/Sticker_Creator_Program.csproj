<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Version>1.0.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">web_pages\assets\SCP_icon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.14.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web_pages\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="web_pages\assets\SCP_icon.ico">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Update="web_pages\assets\emoji_catalog\sheet_64_dirty.png">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!--
    Mirrors the workspace-root signal-cli install next to every build output, including
    runtime-identifier-qualified ones (bin/.../win-x64/), so the application can be run
    directly from bin/ without going through publish.sh. publish.sh is unaffected: it
    publishes to its own -o directory and copies signal-cli there itself, never reading
    from bin/.
  -->
  <Target Name="Copy_signal_cli_for_direct_run" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\signal-cli')">
    <ItemGroup>
      <Signal_cli_source_files Include="$(MSBuildProjectDirectory)\..\signal-cli\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Signal_cli_source_files)" DestinationFolder="$(TargetDir)signal-cli\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
